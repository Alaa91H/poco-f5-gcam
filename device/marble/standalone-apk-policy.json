{
  "schema_version": 1,
  "target": {
    "device": "POCO F5 5G (marble)",
    "rom": "Evolution X",
    "android_version": 17,
    "api_level": 37,
    "package_name": "com.google.android.GoogleCamera",
    "abi": "arm64-v8a"
  },
  "toolchain": {
    "apkeditor": {
      "version": "1.4.9",
      "url": "https://github.com/REAndroid/APKEditor/releases/download/V1.4.9/APKEditor-1.4.9.jar",
      "sha256": "a9cd40df818845456be6d696de6110c89edf4b0a0580cb83438ed6b25a366e67"
    },
    "android_build_tools": "35.0.0",
    "native_library_page_alignment_bytes": 16384,
    "telegram_bot_api": {
      "repository": "https://github.com/tdlib/telegram-bot-api.git",
      "source_sha": "e3e9dd8e5b3d7ab8537cd5a10dc31d5ffa8f82d1"
    }
  },
  "transformations": {
    "merge_split_bundle": true,
    "clean_obsolete_split_metadata": true,
    "remove_feature_splits": false,
    "remove_pairip": false,
    "zipalign": true,
    "resign": true
  },
  "signing": {
    "preferred_mode": "repository-keystore",
    "ephemeral_ci_fallback": true,
    "required_secrets": [
      "GCMOD_KEYSTORE_B64",
      "GCMOD_KEY_ALIAS",
      "GCMOD_KEYSTORE_PASSWORD",
      "GCMOD_KEY_PASSWORD"
    ],
    "ephemeral_ci_fallback_scope": "pull-request-only"
  },
  "notes": [
    "The original Google signature cannot survive bundle merging or any later modification.",
    "Original Google-signed split APKs are the preferred runtime-safe installation path.",
    "A merged standalone APK is experimental until the real-device runtime smoke test passes on POCO F5 / API 37.",
    "A stable repository signing key is required for APK-to-APK upgrades between project-signed experimental builds.",
    "PairIP is not removed or bypassed by this pipeline."
  ],
  "runtime_validation": {
    "required_for_distribution": true,
    "hosted_ci_can_satisfy": false,
    "required_device_codenames": [
      "marble",
      "marblein"
    ],
    "required_api_level": 37,
    "smoke_test_script": "scripts/test-pixel-camera-runtime.ps1"
  },
  "distribution": {
    "preferred_install_mode": "original-google-signed-splits",
    "standalone_status": "experimental-unvalidated",
    "standalone_auto_delivery": false
  }
}
